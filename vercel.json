{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/Omaha/:path*", "destination": "/omaha/:path*", "permanent": true },
    { "source": "/Bellevue/:path*", "destination": "/bellevue/:path*", "permanent": true },
    { "source": "/Elkhorn/:path*", "destination": "/elkhorn/:path*", "permanent": true },
    { "source": "/Gretna/:path*", "destination": "/gretna/:path*", "permanent": true },
    { "source": "/Omaha", "destination": "/omaha", "permanent": true },
    { "source": "/Bellevue", "destination": "/bellevue", "permanent": true },
    { "source": "/Elkhorn", "destination": "/elkhorn", "permanent": true },
    { "source": "/Gretna", "destination": "/gretna", "permanent": true },

    { "source": "/:loc(omaha|bellevue|elkhorn|gretna)/guitar-lessons", "destination": "/:loc/guitar", "permanent": true },
    { "source": "/:loc(omaha|bellevue|elkhorn|gretna)/piano-lessons", "destination": "/:loc/piano", "permanent": true },
    { "source": "/:loc(omaha|bellevue|elkhorn|gretna)/drum-lessons", "destination": "/:loc/drums", "permanent": true },
    { "source": "/:loc(omaha|bellevue|elkhorn|gretna)/vocal-lessons", "destination": "/:loc/vocals", "permanent": true },
    { "source": "/:loc(omaha|bellevue|elkhorn|gretna)/bass-guitar-lessons", "destination": "/:loc/more", "permanent": true },

    { "source": "/:loc(omaha|bellevue|elkhorn|gretna)/signup", "destination": "/:loc", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(omaha|bellevue|elkhorn|gretna)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/(kids-music-lessons|adult-music-lessons|beginner-music-lessons|private-music-lessons|about|locations)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/((?!assets/|omaha|bellevue|elkhorn|gretna).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
