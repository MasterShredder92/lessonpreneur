{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/Omaha/:path*", "destination": "/omaha/:path*", "permanent": true },
    { "source": "/Bellevue/:path*", "destination": "/bellevue/:path*", "permanent": true },
    { "source": "/Elkhorn/:path*", "destination": "/elkhorn/:path*", "permanent": true },
    { "source": "/Gretna/:path*", "destination": "/gretna/:path*", "permanent": true },
    { "source": "/Omaha", "destination": "/omaha", "permanent": true },
    { "source": "/Bellevue", "destination": "/bellevue", "permanent": true },
    { "source": "/Elkhorn", "destination": "/elkhorn", "permanent": true },
    { "source": "/Gretna", "destination": "/gretna", "permanent": true },

    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "elkhornlessons.com" }], "destination": "https://www.lessonpreneur.io/elkhorn/:path", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "elkhornlessons.com" }], "destination": "https://www.lessonpreneur.io/elkhorn", "permanent": true },
    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "www.elkhornlessons.com" }], "destination": "https://www.lessonpreneur.io/elkhorn/:path", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "www.elkhornlessons.com" }], "destination": "https://www.lessonpreneur.io/elkhorn", "permanent": true },

    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "musiclessonsbellevue.com" }], "destination": "https://www.lessonpreneur.io/bellevue/:path", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "musiclessonsbellevue.com" }], "destination": "https://www.lessonpreneur.io/bellevue", "permanent": true },
    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "www.musiclessonsbellevue.com" }], "destination": "https://www.lessonpreneur.io/bellevue/:path", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "www.musiclessonsbellevue.com" }], "destination": "https://www.lessonpreneur.io/bellevue", "permanent": true },

    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "omahaguitarandmusiclessons.com" }], "destination": "https://www.lessonpreneur.io/omaha/:path", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "omahaguitarandmusiclessons.com" }], "destination": "https://www.lessonpreneur.io/omaha", "permanent": true },
    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "www.omahaguitarandmusiclessons.com" }], "destination": "https://www.lessonpreneur.io/omaha/:path", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "www.omahaguitarandmusiclessons.com" }], "destination": "https://www.lessonpreneur.io/omaha", "permanent": true },

    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "gretnamusiclessons.com" }], "destination": "https://www.lessonpreneur.io/gretna/:path", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "gretnamusiclessons.com" }], "destination": "https://www.lessonpreneur.io/gretna", "permanent": true },
    { "source": "/:path((?!api/).*)", "has": [{ "type": "host", "value": "www.gretnamusiclessons.com" }], "destination": "https://www.lessonpreneur.io/gretna/:path", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "www.gretnamusiclessons.com" }], "destination": "https://www.lessonpreneur.io/gretna", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(omaha|bellevue|elkhorn|gretna)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/((?!assets/|omaha|bellevue|elkhorn|gretna).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
